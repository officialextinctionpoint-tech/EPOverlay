{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Extinction Point Overlay",
  "version": "1.2.1",
  "identifier": "app.extinctionpoint.overlay",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Extinction Point HUD",
        "url": "https://extinctionpoint.app/overlay?app=1.2.1",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "resizable": true,
        "skipTaskbar": false,
        "shadow": false,
        "focus": false,
        "maximized": false,
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}